{
  "name": "@subf/unocss",
  "version": "0.0.0",
  "description": "A custom subset of UnoCSS packages",
  "keywords": [
    "atomic-css",
    "tailwind",
    "unocss",
    "windicss"
  ],
  "homepage": "https://github.com/subframe7536/unocss#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/unocss/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/unocss.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./oxlint-plugin": "./dist/oxlint-plugin.mjs",
    "./vite": "./dist/vite.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json",
    "./reset-eric-meyer.css": "./dist/reset-eric-meyer.css",
    "./reset-normalize.css": "./dist/reset-normalize.css",
    "./reset-tailwind-compat.css": "./dist/reset-tailwind-compat.css",
    "./reset-tailwind-v4.css": "./dist/reset-tailwind-v4.css",
    "./reset-tailwind.css": "./dist/reset-tailwind.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "qa": "bun run typecheck && oxlint --fix && oxfmt",
    "test": "node --test",
    "release": "bumpp --all",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@oxlint/plugins": "^1.58.0",
    "@unocss/config": "^66.0.0",
    "@unocss/core": "^66.0.0",
    "@unocss/preset-icons": "^66.0.0",
    "@unocss/preset-web-fonts": "^66.0.0",
    "@unocss/preset-wind3": "^66.0.0",
    "@unocss/preset-wind4": "^66.0.0",
    "@unocss/reset": "^66.0.0",
    "@unocss/transformer-directives": "^66.0.0",
    "@unocss/transformer-variant-group": "^66.0.0",
    "pathe": "^2.0.3",
    "synckit": "^0.11.12",
    "tinyglobby": "^0.2.15",
    "unocss-preset-completion": "^0.3.1"
  },
  "devDependencies": {
    "@subf/config": "^0.1.1",
    "@types/node": "^22",
    "@unocss/vite": "^66.0.0",
    "bumpp": "^10",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsdown": "^0.21.0",
    "typescript": "^5.9.0",
    "vite": "^8"
  },
  "peerDependencies": {
    "magic-string": "*",
    "vite": "^5 || ^6 || ^7 || ^8"
  },
  "overrides": {
    "@unocss/inspector": "npm:has-flag"
  },
  "inlinedDependencies": {
    "@unocss/vite": "66.6.7"
  }
}

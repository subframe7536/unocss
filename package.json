{
  "name": "@subf/unocss",
  "type": "module",
  "version": "0.1.0",
  "description": "A subset of UnoCSS: core, presetWind3, presetIcons, presetWebFonts, transformerVariantGroup, transformerDirectives, vite (no inspector), oxlint-plugin (no @typescript-eslint/utils, oxlint-optimized)",
  "author": "subframe7536",
  "license": "MIT",
  "homepage": "https://github.com/subframe7536/unocss#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/unocss.git"
  },
  "bugs": {
    "url": "https://github.com/subframe7536/unocss/issues"
  },
  "keywords": [
    "unocss",
    "atomic-css",
    "tailwind",
    "windicss"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "qa": "bun run typecheck && oxlint --fix && oxfmt",
    "release": "bun run build && bumpp"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.58.0",
    "@unocss/config": "^66.0.0",
    "@unocss/core": "^66.0.0",
    "@unocss/preset-icons": "^66.0.0",
    "@unocss/preset-web-fonts": "^66.0.0",
    "@unocss/preset-wind3": "^66.0.0",
    "@unocss/transformer-directives": "^66.0.0",
    "@unocss/transformer-variant-group": "^66.0.0",
    "magic-string": "^0.30.0",
    "synckit": "^0.9.0"
  },
  "peerDependencies": {
    "vite": "^5 || ^6 || ^7 || ^8"
  },
  "devDependencies": {
    "@subf/config": "^0.1.0",
    "@types/eslint": "^9",
    "@types/estree": "^1",
    "@types/node": "^22",
    "@unocss/vite": "^66.0.0",
    "bumpp": "^10",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsdown": "^0.21.0",
    "typescript": "^5.9.0",
    "vite": "^8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./oxlint-plugin": "./dist/oxlint-plugin.mjs",
    "./vite": "./dist/vite.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json"
  },
  "inlinedDependencies": {
    "@jridgewell/gen-mapping": "0.3.13",
    "@jridgewell/remapping": "2.3.5",
    "@jridgewell/resolve-uri": "3.1.2",
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/eslint": "9.6.1",
    "@types/estree": "1.0.8",
    "@types/json-schema": "7.0.15",
    "@unocss/vite": "66.6.7",
    "chokidar": "5.0.0",
    "fdir": "6.5.0",
    "pathe": "2.0.3",
    "picomatch": "4.0.4",
    "readdirp": "5.0.0",
    "tinyglobby": "0.2.15",
    "unplugin-utils": "0.3.1"
  }
}

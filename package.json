{
  "name": "@subf/unocss",
  "version": "0.3.1",
  "description": "A custom subset of UnoCSS packages",
  "keywords": [
    "atomic-css",
    "tailwind",
    "unocss",
    "windicss"
  ],
  "homepage": "https://github.com/subframe7536/unocss#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/unocss/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/unocss.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./oxlint-plugin": "./dist/oxlint-plugin.mjs",
    "./vite": "./dist/vite.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json",
    "./reset-eric-meyer.css": "./dist/reset-eric-meyer.css",
    "./reset-normalize.css": "./dist/reset-normalize.css",
    "./reset-tailwind-compat.css": "./dist/reset-tailwind-compat.css",
    "./reset-tailwind-v4.css": "./dist/reset-tailwind-v4.css",
    "./reset-tailwind.css": "./dist/reset-tailwind.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "qa": "pnpm run typecheck && pnpm run lint && pnpm run format",
    "test": "node --test",
    "release": "bumpp --all",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@unocss/config": "^66.10.5",
    "@unocss/core": "^66.10.5",
    "@unocss/preset-icons": "^66.10.5",
    "@unocss/preset-web-fonts": "^66.10.5",
    "@unocss/preset-wind3": "^66.10.5",
    "@unocss/preset-wind4": "^66.10.5",
    "@unocss/reset": "^66.10.5",
    "@unocss/transformer-compile-class": "^66.10.5",
    "@unocss/transformer-directives": "^66.10.5",
    "@unocss/transformer-variant-group": "^66.10.5",
    "pathe": "^2.0.3",
    "synckit": "^0.11.13",
    "tinyglobby": "^0.2.17",
    "unocss-preset-completion": "^0.4.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.86.0",
    "@subf/config": "^0.4.0",
    "@types/node": "^24.19.0",
    "@unocss/vite": "66.10.5",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "peerDependencies": {
    "@jridgewell/remapping": "*",
    "magic-string": "*",
    "vite": "^8.3.1"
  },
  "packageManager": "pnpm@12.6.0",
  "inlinedDependencies": {
    "@unocss/vite": "66.10.5"
  }
}

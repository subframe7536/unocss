{
  "name": "@subf/unocss",
  "type": "module",
  "version": "0.1.0",
  "description": "A subset of UnoCSS: core, presetWind3, presetIcons, presetWebFonts, transformerVariantGroup, transformerDirectives, vite (no inspector), eslint-plugin (no @typescript-eslint/utils, oxlint-optimized)",
  "author": "subframe7536",
  "license": "MIT",
  "homepage": "https://github.com/subframe7536/unocss#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/unocss.git"
  },
  "bugs": {
    "url": "https://github.com/subframe7536/unocss/issues"
  },
  "keywords": [
    "unocss",
    "atomic-css",
    "tailwind",
    "windicss"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./vite": "./dist/vite.mjs",
    "./eslint-plugin": {
      "import": "./dist/eslint-plugin.mjs",
      "require": "./dist/eslint-plugin.cjs"
    },
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bun run build && bumpp"
  },
  "dependencies": {
    "@unocss/config": "^66.0.0",
    "@unocss/core": "^66.0.0",
    "@unocss/preset-icons": "^66.0.0",
    "@unocss/preset-web-fonts": "^66.0.0",
    "@unocss/preset-wind3": "^66.0.0",
    "@unocss/transformer-directives": "^66.0.0",
    "@unocss/transformer-variant-group": "^66.0.0",
    "@unocss/vite": "^66.0.0",
    "magic-string": "^0.30.0",
    "synckit": "^0.9.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "vite": ">=2.9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@subframe7536/eslint-config": "^1.3.2",
    "@types/eslint": "^9",
    "@types/estree": "^1",
    "@types/node": "^22",
    "bumpp": "^10",
    "eslint": "^9",
    "tsdown": "^0.17.0",
    "typescript": "^5.9.0",
    "vite": "^6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

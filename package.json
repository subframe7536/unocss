{
  "name": "@subf/unocss",
  "version": "0.1.0",
  "description": "A subset of UnoCSS: core, presetWind3/4, presetIcons, presetWebFonts, transformerVariantGroup, transformerDirectives, vite (no inspector), oxlint-plugin (no @typescript-eslint/utils, oxlint-optimized)",
  "keywords": [
    "atomic-css",
    "tailwind",
    "unocss",
    "windicss"
  ],
  "homepage": "https://github.com/subframe7536/unocss#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/unocss/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/unocss.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./oxlint-plugin": "./dist/oxlint-plugin.mjs",
    "./vite": "./dist/vite.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "qa": "bun run typecheck && oxlint --fix && oxfmt",
    "release": "bun run build && bumpp"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@oxlint/plugins": "^1.58.0",
    "@unocss/config": "^66.0.0",
    "@unocss/core": "^66.0.0",
    "@unocss/preset-icons": "^66.0.0",
    "@unocss/preset-web-fonts": "^66.0.0",
    "@unocss/preset-wind3": "^66.0.0",
    "@unocss/preset-wind4": "^66.0.0",
    "@unocss/transformer-directives": "^66.0.0",
    "@unocss/transformer-variant-group": "^66.0.0",
    "chokidar": "^5.0.0",
    "magic-string": "^0.30.0",
    "pathe": "^2.0.3",
    "synckit": "^0.11.12",
    "tinyglobby": "^0.2.15",
    "unocss-preset-completion": "0.3.1"
  },
  "devDependencies": {
    "@subf/config": "^0.1.0",
    "@types/node": "^22",
    "@unocss/vite": "^66.0.0",
    "bumpp": "^10",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "tsdown": "^0.21.0",
    "typescript": "^5.9.0",
    "vite": "^8"
  },
  "peerDependencies": {
    "vite": "^5 || ^6 || ^7 || ^8"
  },
  "overrides": {
    "@unocss/inspector": "npm:has-flag"
  },
  "inlinedDependencies": {
    "@unocss/vite": "66.6.7"
  }
}

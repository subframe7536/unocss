{
  "name": "@subf/unocss",
  "version": "0.3.1",
  "description": "A custom subset of UnoCSS packages",
  "keywords": [
    "atomic-css",
    "tailwind",
    "unocss",
    "windicss"
  ],
  "homepage": "https://github.com/subframe7536/unocss#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/unocss/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/unocss.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./oxlint-plugin": "./dist/oxlint-plugin.mjs",
    "./vite": "./dist/vite.mjs",
    "./worker": "./dist/worker.mjs",
    "./package.json": "./package.json",
    "./reset-eric-meyer.css": "./dist/reset-eric-meyer.css",
    "./reset-normalize.css": "./dist/reset-normalize.css",
    "./reset-tailwind-compat.css": "./dist/reset-tailwind-compat.css",
    "./reset-tailwind-v4.css": "./dist/reset-tailwind-v4.css",
    "./reset-tailwind.css": "./dist/reset-tailwind.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "fmt": "oxfmt",
    "qa": "nub run typecheck && nub run lint && nub run format",
    "test": "node --test",
    "release": "bumpp --all",
    "prepublishOnly": "nub run build"
  },
  "dependencies": {
    "@unocss/config": "^66.9.2",
    "@unocss/core": "^66.9.2",
    "@unocss/preset-icons": "^66.9.2",
    "@unocss/preset-web-fonts": "^66.9.2",
    "@unocss/preset-wind3": "^66.9.2",
    "@unocss/preset-wind4": "^66.9.2",
    "@unocss/reset": "^66.9.2",
    "@unocss/transformer-compile-class": "^66.9.2",
    "@unocss/transformer-directives": "^66.9.2",
    "@unocss/transformer-variant-group": "^66.9.2",
    "pathe": "^2.0.3",
    "synckit": "^0.11.13",
    "tinyglobby": "^0.2.17",
    "unocss-preset-completion": "^0.4.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.77.0",
    "@subf/config": "^0.4.0",
    "@types/node": "^22.20.0",
    "@unocss/vite": "^66.9.2",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "magic-string": "*",
    "vite": "^8.2.2"
  },
  "overrides": {
    "@unocss/inspector": "npm:has-flag"
  },
  "inlinedDependencies": {
    "@unocss/vite": "66.9.2",
    "chokidar": "5.0.0",
    "readdirp": "5.1.1"
  }
}
